# Copy to ../.env.local (root of the parent project, next to vite.config.js) — never served to the browser
QLIK_TENANT=your-tenant.eu.qlikcloud.com
QLIK_API_KEY=your-api-key        # Qlik Cloud → profile → Settings → API keys
QLIK_APP_ID=00000000-0000-0000-0000-000000000000   # app opened by default
