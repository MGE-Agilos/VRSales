# À copier dans ../.env.local (racine du projet VR, à côté de vite.config.js) — ce fichier n'est jamais servi au navigateur
QLIK_TENANT=votre-tenant.eu.qlikcloud.com
QLIK_API_KEY=votre-cle-api        # Qlik Cloud → profil → Paramètres → Clés API
QLIK_APP_ID=00000000-0000-0000-0000-000000000000   # app ouverte par défaut
